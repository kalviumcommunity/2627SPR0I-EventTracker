
PORT=5000
NODE_ENV=production

POSTGRES_USER=replace_with_local_db_user
POSTGRES_PASSWORD=replace_with_local_db_password
POSTGRES_DB=replace_with_local_db_name

DATABASE_URL=postgresql://replace_with_local_db_user:replace_with_local_db_password@postgres:5432/replace_with_local_db_name

SESSION_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173

GOOGLE_CLIENT_ID=your_google_client_id

# Set to true only to exercise the database-outage response.
PRACTICE_DB_OUTAGE=false
